@page "/export"
@using CompensationAltimetrique.Web.Services
@using static CompensationAltimetrique.Web.Services.CompensationService
@inject CompensationService CompensationSvc
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Export - Compensation Altimétrique</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-download"></i> 5. Export des Résultats
                    </h4>
                </div>
                <div class="card-body">
                    @if (CompensationSvc.HasResults)
                    {
                        <div class="row mb-4">
                            <div class="col-md-4">
                                <div class="card border-primary">
                                    <div class="card-body text-center">
                                        <i class="bi bi-file-earmark-pdf display-4 text-danger mb-3"></i>
                                        <h5>Rapport PDF</h5>
                                        <p class="text-muted">Rapport complet avec graphiques et statistiques</p>
                                        <button class="btn btn-outline-primary" disabled>
                                            <i class="bi bi-download"></i> Télécharger PDF
                                        </button>
                                        <small class="d-block mt-2 text-muted">🚧 En développement</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-success">
                                    <div class="card-body text-center">
                                        <i class="bi bi-file-earmark-excel display-4 text-success mb-3"></i>
                                        <h5>Fichier Excel</h5>
                                        <p class="text-muted">Données brutes et résultats calculés</p>
                                        <button class="btn btn-outline-success" disabled>
                                            <i class="bi bi-download"></i> Télécharger Excel
                                        </button>
                                        <small class="d-block mt-2 text-muted">🚧 En développement</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-warning">
                                    <div class="card-body text-center">
                                        <i class="bi bi-file-earmark-code display-4 text-warning mb-3"></i>
                                        <h5>Format JSON</h5>
                                        <p class="text-muted">Données machine-readable pour APIs</p>
                                        <button class="btn btn-outline-warning" @onclick="ExportJson">
                                            <i class="bi bi-download"></i> Télécharger JSON
                                        </button>
                                        <small class="d-block mt-2 text-success">✅ Fonctionnel</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title">📋 Aperçu des Données d'Export</h6>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <strong>Contenu inclus :</strong>
                                                <ul class="list-unstyled mt-2">
                                                    <li>✅ Points compensés avec altitudes finales</li>
                                                    <li>✅ Corrections appliquées</li>
                                                    <li>✅ Écarts-types calculés</li>
                                                    <li>✅ Statistiques globales</li>
                                                    <li>✅ Paramètres de compensation utilisés</li>
                                                </ul>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Métadonnées :</strong>
                                                <ul class="list-unstyled mt-2">
                                                    <li><strong>Date :</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</li>
                                                    <li><strong>Points traités :</strong> @CompensationSvc.DataCount</li>
                                                    <li><strong>RMS résidus :</strong> @(CompensationSvc.Results?.RmsResiduals.ToString("F3") ?? "N/A") mm</li>
                                                    <li><strong>Temps de calcul :</strong> @CompensationSvc.ComputationTime</li>
                                                    <li><strong>Version :</strong> DickPy C# 2.0</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Aucun résultat à exporter</strong><br/>
                            Veuillez d'abord effectuer les calculs de compensation.
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <button class="btn btn-outline-secondary" @onclick="@(() => Navigation.NavigateTo("/results"))">
                            <i class="bi bi-arrow-left"></i> Retour aux Résultats
                        </button>
                        <button class="btn btn-success" @onclick="@(() => Navigation.NavigateTo("/import"))">
                            <i class="bi bi-arrow-clockwise"></i> Nouveau Projet
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private async Task ExportJson()
    {
        if (CompensationSvc.HasResults && CompensationSvc.Results != null)
        {
            var exportData = new
            {
                metadata = new
                {
                    version = "DickPy C# 2.0",
                    exportDate = DateTime.Now,
                    pointsCount = CompensationSvc.DataCount,
                    rmsResiduals = CompensationSvc.Results.RmsResiduals,
                    computationTime = CompensationSvc.ComputationTime
                },
                parameters = new
                {
                    referencePoint = CompensationSvc.ReferencePointId,
                    referenceAltitude = CompensationSvc.ReferenceAltitude,
                    targetPrecision = CompensationSvc.TargetPrecision,
                    instrumentalError = CompensationSvc.InstrumentalError,
                    kilometricError = CompensationSvc.KilometricError
                },
                results = CompensationSvc.Results.AdjustedPoints?.Select(p => new
                {
                    pointId = p.Matricule,
                    compensatedAltitude = p.Altitude,
                    precision = p.Precision,
                    isReference = p.IsReference
                }).ToArray()
            };

            var json = System.Text.Json.JsonSerializer.Serialize(exportData, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });

            // Note: Dans une vraie implémentation, on utiliserait IJSRuntime pour télécharger le fichier
            // Pour l'instant, on affiche juste un message
            await Task.Delay(500); // Simulation du téléchargement
        }
    }
}