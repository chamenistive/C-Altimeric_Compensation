@page "/results"
@using CompensationAltimetrique.Web.Services
@using static CompensationAltimetrique.Web.Services.CompensationService
@inject CompensationService CompensationSvc
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Résultats - Compensation Altimétrique</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-table"></i> 4. Résultats de la Compensation
                    </h4>
                </div>
                <div class="card-body">
                    @if (CompensationSvc.HasResults)
                    {
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title">📊 Statistiques Globales</h6>
                                        <ul class="list-unstyled">
                                            <li><strong>Points traités :</strong> @CompensationSvc.DataCount</li>
                                            <li><strong>Distance totale :</strong> @(CompensationSvc.Results?.TotalDistance.ToString("F2") ?? "N/A") m</li>
                                            <li><strong>RMS des résidus :</strong> @(CompensationSvc.Results?.RmsResiduals.ToString("F3") ?? "N/A") mm</li>
                                            <li><strong>Temps de calcul :</strong> @CompensationSvc.ComputationTime</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-success text-white">
                                    <div class="card-body">
                                        <h6 class="card-title">✅ Validation</h6>
                                        <ul class="list-unstyled">
                                            <li><i class="bi bi-check-circle"></i> Compensation terminée avec succès</li>
                                            <li><i class="bi bi-check-circle"></i> Précision respectée</li>
                                            <li><i class="bi bi-check-circle"></i> Résultats cohérents</li>
                                            <li><i class="bi bi-check-circle"></i> Prêt pour export</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <h5>📋 Tableau des Résultats</h5>
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Point</th>
                                                <th>Altitude Compensée (m)</th>
                                                <th>Correction (mm)</th>
                                                <th>Écart-type (mm)</th>
                                                <th>Statut</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (CompensationSvc.Results?.AdjustedPoints != null)
                                            {
                                                @foreach (var point in CompensationSvc.Results.AdjustedPoints)
                                                {
                                                    <tr>
                                                        <td><strong>@point.Matricule</strong></td>
                                                        <td>@point.Altitude.ToString("F4")</td>
                                                        <td>N/A</td>
                                                        <td>@((point.Precision * 1000).ToString("F1"))</td>
                                                        <td>
                                                            <span class="badge bg-success">
                                                                <i class="bi bi-check-circle"></i> Validé
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Aucun résultat disponible</strong><br/>
                            Veuillez d'abord effectuer les calculs de compensation.
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <button class="btn btn-outline-secondary" @onclick="@(() => Navigation.NavigateTo("/computation"))">
                            <i class="bi bi-arrow-left"></i> Retour aux Calculs
                        </button>
                        @if (CompensationSvc.HasResults)
                        {
                            <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo("/export"))">
                                <i class="bi bi-download"></i> Continuer vers l'Export
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>